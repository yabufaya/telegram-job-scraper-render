# ---------- Telegram (ONLY needed for the optional Telethon fallback) ----------
# Users never supply these. They are YOUR server-side credentials, used only when a
# channel has its public web preview disabled. Leave blank to run in 100% no-login mode.
#   Get them: https://my.telegram.org -> API Development Tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Generated ONCE locally with:  python scripts/make_session.py
# Paste the long string here (Render -> Environment). Never commit it.
TELEGRAM_SESSION_STRING=

# Which source to try first: preview (no login, safe) then telethon (needs session).
# Set to "telethon" if you want full history fidelity first.
TELEGRAM_SOURCE_ORDER=preview,telethon

# ---------- Optional server-side LLM fallback ----------
# STRICT MODE IS THE DEFAULT: leave these blank and every visitor MUST bring their own key.
# If you fill them in, they are used only for visitors who did not supply a key, and the
# key is never sent to the browser (see /config -> has_server_key).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_NAME=

# If a visitor doesn't enter a key, do we allow the server key? (default: no)
ALLOW_SERVER_LLM_FALLBACK=false

# ---------- Batching / scan limits ----------
BATCH_SIZE=15
MAX_CONCURRENT_LLM_CALLS=3
# Hard ceiling on messages pulled per scan (protects you and Telegram)
MAX_POSTS_PER_SCAN=600
# How far back a single scan may reach (days). Guards against 3-year scans.
MAX_LOOKBACK_DAYS=120
# A batch is also split if its combined text is longer than this (keeps prompts in context)
MAX_BATCH_CHARS=40000
# Per-post text is truncated to this many characters before being sent to the LLM
MAX_CHARS_PER_POST=6000
# Collapse reposts of the identical job text so you don't pay the LLM twice
DEDUPE_BY_TEXT=true

# ---------- Abuse protection ----------
RATE_LIMIT_SCANS_PER_HOUR=6
RATE_LIMIT_IP_CONCURRENCY=1
GLOBAL_CONCURRENCY=4
# Block SSRF: only https LLM URLs, no private/loopback/metadata IPs
ALLOW_INSECURE_LLM_URLS=false

# ---------- App ----------
PORT=8000
LOG_LEVEL=INFO
